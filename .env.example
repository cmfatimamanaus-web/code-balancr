# Variáveis usadas pelo Tesouro Espiritual.
# Copie para a Vercel em Settings > Environment Variables (Production + Preview).

# --- Cliente (expostas ao navegador, podem ser públicas) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# --- Servidor (NUNCA expor no navegador, sem prefixo VITE_) ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secreta: cadastrar somente no painel da Vercel, jamais no repositório.
SUPABASE_SERVICE_ROLE_KEY=""
# Opcional: senha do responsável (padrão: responsavel2026)
MODERADOR_SENHA=""
